---
// The one page. All text comes from data/ (see data/site.yaml).
import path from 'node:path';
import { loadSite } from '../../scripts/lib/site.js';
import '../styles/global.css';

const s = await loadSite(path.join(process.cwd(), 'data'));

const stageBadge = {
  'approved-us': 'bg-emerald-100 text-emerald-900 dark:bg-emerald-900/40 dark:text-emerald-200',
  'approved-elsewhere': 'bg-teal-100 text-teal-900 dark:bg-teal-900/40 dark:text-teal-200',
  pivotal: 'bg-sky-100 text-sky-900 dark:bg-sky-900/40 dark:text-sky-200',
  early: 'bg-indigo-100 text-indigo-900 dark:bg-indigo-900/40 dark:text-indigo-200',
  lab: 'bg-zinc-200 text-zinc-800 dark:bg-zinc-800 dark:text-zinc-200',
};
const statusText = {
  active: 'text-zinc-700 dark:text-zinc-300',
  approved: 'text-emerald-800 dark:text-emerald-300',
  stalled: 'text-amber-800 dark:text-amber-300',
  discontinued: 'text-rose-800 dark:text-rose-300',
};
const tag = 'ml-1 inline-block rounded border border-zinc-300 px-1.5 text-xs text-zinc-600 dark:border-zinc-600 dark:text-zinc-400';
const link = 'underline decoration-zinc-400 underline-offset-2 hover:decoration-current';
const h = 'text-xs font-semibold uppercase tracking-wide text-zinc-500 dark:text-zinc-400';
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{s.title}</title>
    <meta name="description" content={s.tagline} />
  </head>
  <body class="bg-white text-zinc-900 antialiased dark:bg-zinc-950 dark:text-zinc-100">
    <main class="mx-auto max-w-5xl px-4 py-8 sm:py-12">
      <header class="space-y-3">
        <h1 class="text-3xl font-bold tracking-tight">{s.title}</h1>
        {s.tagline && <p class="text-zinc-700 dark:text-zinc-300">{s.tagline}</p>}
        <p role="note" class="rounded-md border-l-4 border-amber-500 bg-amber-50 p-3 text-sm text-amber-950 dark:bg-amber-950/40 dark:text-amber-100">
          {s.notAdvice}
        </p>
        <p class="text-sm text-zinc-500 dark:text-zinc-400">
          {s.lastUpdated && <>Last updated <time datetime={s.lastUpdated}>{s.lastUpdated}</time>. </>}
          {s.total} lenses and drugs.
        </p>
      </header>

      <section aria-labelledby="stages" class="mt-8">
        <h2 id="stages" class={h}>How far each one has got</h2>
        <dl class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-5">
          {s.counts.map((c) => (
            <div class="rounded-lg border border-zinc-200 p-3 dark:border-zinc-800">
              <dt class="text-sm font-medium">{c.label}</dt>
              <dd class="text-2xl font-bold tabular-nums">{c.count}</dd>
              {c.about && <dd class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">{c.about}</dd>}
            </div>
          ))}
        </dl>
      </section>

      <div role="group" aria-label="Show a group" class="mt-8 flex flex-wrap gap-2">
        {[{ key: 'all', label: 'All' }, ...s.groups].map((g) => (
          <button
            type="button"
            data-filter={g.key}
            aria-pressed={g.key === 'all' ? 'true' : 'false'}
            class="rounded-full border border-zinc-300 px-4 py-1.5 text-sm font-medium hover:bg-zinc-100 aria-pressed:border-zinc-900 aria-pressed:bg-zinc-900 aria-pressed:text-white dark:border-zinc-700 dark:hover:bg-zinc-800 dark:aria-pressed:border-zinc-100 dark:aria-pressed:bg-zinc-100 dark:aria-pressed:text-zinc-900"
          >{g.label}</button>
        ))}
      </div>

      <table class="mt-4 w-full border-collapse text-left text-sm">
        <caption class="sr-only">Lenses and drugs. Select a name to see its facts and sources.</caption>
        <thead class="border-b border-zinc-300 dark:border-zinc-700">
          <tr class={h}>
            <th scope="col" class="py-2 pr-3">Lens</th>
            <th scope="col" class="hidden py-2 pr-3 sm:table-cell">Company</th>
            <th scope="col" class="py-2 pr-3">Stage</th>
            <th scope="col" class="hidden py-2 pr-3 md:table-cell">Type</th>
            <th scope="col" class="hidden py-2 pr-3 md:table-cell">Where you can get it</th>
            <th scope="col" class="py-2">Status</th>
          </tr>
        </thead>
        {s.groups.map((g) => (
          <tbody data-group={g.key}>
            <tr>
              <th scope="colgroup" colspan="6" class="pt-6 pb-2 font-normal">
                <span class="text-base font-semibold">{g.label}</span>
                {g.about && <span class="block text-zinc-600 dark:text-zinc-400">{g.about}</span>}
                {g.note && (
                  <span class="mt-2 block rounded-md bg-zinc-100 p-2 font-semibold dark:bg-zinc-900">{g.note}</span>
                )}
              </th>
            </tr>
            {g.entries.map((e) => (
              <>
                <tr data-row class="cursor-pointer border-t border-zinc-200 align-top hover:bg-zinc-50 dark:border-zinc-800 dark:hover:bg-zinc-900">
                  <td class="py-2 pr-3">
                    <button type="button" aria-expanded="true" aria-controls={`d-${e.id}`} class="text-left font-medium underline-offset-2 hover:underline">
                      {e.name}
                    </button>
                    <span class="block text-xs text-zinc-500 sm:hidden dark:text-zinc-400">{e.company}</span>
                  </td>
                  <td class="hidden py-2 pr-3 sm:table-cell">{e.company}</td>
                  <td class="py-2 pr-3">
                    <span class={`inline-block whitespace-nowrap rounded px-2 py-0.5 text-xs font-medium ${stageBadge[e.stage]}`}>{e.stageLabel}</span>
                  </td>
                  <td class="hidden py-2 pr-3 md:table-cell">{e.type || '—'}</td>
                  <td class="hidden py-2 pr-3 md:table-cell">{e.availability}</td>
                  <td class={`py-2 ${statusText[e.status]}`}>{e.statusLabel}</td>
                </tr>
                <tr id={`d-${e.id}`} data-panel>
                  <td colspan="6" class="pb-4">
                    <div class="grid gap-4 rounded-lg bg-zinc-50 p-4 sm:grid-cols-2 dark:bg-zinc-900">
                      <div class="space-y-3">
                        <dl class="grid grid-cols-[max-content_1fr] gap-x-3 gap-y-1">
                          <dt class="text-zinc-500 dark:text-zinc-400">Company</dt><dd>{e.company}</dd>
                          <dt class="text-zinc-500 dark:text-zinc-400">Type</dt><dd>{e.type || 'Not stated in the sources'}</dd>
                          <dt class="text-zinc-500 dark:text-zinc-400">Where</dt><dd>{e.availability}</dd>
                          {e.codeNames.length > 0 && <><dt class="text-zinc-500 dark:text-zinc-400">Codes</dt><dd>{e.codeNames.join(', ')}</dd></>}
                        </dl>
                        {e.howItWorks && <div><h3 class={h}>How it works</h3><p>{e.howItWorks}</p></div>}
                        {e.summary && <div><h3 class={h}>Summary</h3><p>{e.summary}</p></div>}
                        {e.tradeOffs && <div><h3 class={h}>Trade-offs</h3><p>{e.tradeOffs}</p></div>}
                        {!e.summary && !e.tradeOffs && (
                          <p class="text-zinc-500 italic dark:text-zinc-400">Summary and trade-offs: not written yet.</p>
                        )}
                        {e.results.length > 0 && (
                          <div>
                            <h3 class={h}>Results</h3>
                            <ul class="list-disc space-y-1 pl-5">
                              {e.results.map((r) => (
                                <li>{r.text}<span class={tag}>{r.evidence}</span> <a class={link} href={r.source}>source</a></li>
                              ))}
                            </ul>
                          </div>
                        )}
                        {e.latest && (
                          <div>
                            <h3 class={h}>Latest</h3>
                            <p><time datetime={e.latest.date}>{e.latest.date}</time>: {e.latest.text}<span class={tag}>{e.latest.evidence}</span></p>
                          </div>
                        )}
                      </div>
                      <div class="space-y-3">
                        {e.trials.length > 0 && (
                          <div>
                            <h3 class={h}>Trials</h3>
                            <ul class="space-y-2">
                              {e.trials.map((t) => (
                                <li>
                                  <a class={link} href={t.url}>{t.nct}</a>: {t.status}
                                  <span class="block text-xs text-zinc-600 dark:text-zinc-400">
                                    {[t.people, t.countries, t.start && `start ${t.start}`, t.end && `end ${t.end}`].filter(Boolean).join(' · ')}
                                  </span>
                                </li>
                              ))}
                            </ul>
                          </div>
                        )}
                        {e.fda.length > 0 && (
                          <div>
                            <h3 class={h}>FDA approvals</h3>
                            <ul class="space-y-1">
                              {e.fda.map((f) => <li><a class={link} href={f.url}>{f.key}</a>, <time datetime={f.date}>{f.date}</time></li>)}
                            </ul>
                          </div>
                        )}
                        <div>
                          <h3 class={h}>Sources</h3>
                          <ul class="space-y-1">
                            {e.sources.map((src) => (
                              <li><a class={link} href={src.url}>{src.label}</a> <span class="text-xs text-zinc-500 dark:text-zinc-400">read {src.read}</span></li>
                            ))}
                          </ul>
                        </div>
                        {e.reviewed && <p class="text-xs text-zinc-500 dark:text-zinc-400">Last reviewed {e.reviewed}</p>}
                      </div>
                    </div>
                  </td>
                </tr>
              </>
            ))}
          </tbody>
        ))}
      </table>

      {s.statuses.length > 0 && (
        <section aria-labelledby="statuses" class="mt-10">
          <h2 id="statuses" class={h}>Status words</h2>
          <dl class="mt-2 space-y-1 text-sm">
            {s.statuses.map((st) => <div><dt class="inline font-semibold">{st.label}: </dt><dd class="inline">{st.about}</dd></div>)}
          </dl>
        </section>
      )}

      {s.today && (
        <section aria-labelledby="today" class="mt-10">
          <h2 id="today" class="text-xl font-semibold">{s.today.title}</h2>
          <p class="mt-2 whitespace-pre-line">{s.today.text}</p>
        </section>
      )}

      {s.terms.length > 0 && (
        <section aria-labelledby="terms" class="mt-10">
          <h2 id="terms" class={h}>Words on this page</h2>
          <dl class="mt-2 space-y-1 text-sm">
            {s.terms.map((t) => <div><dt class="inline font-semibold">{t.term}: </dt><dd class="inline">{t.text}</dd></div>)}
          </dl>
        </section>
      )}

      <footer class="mt-12 space-y-3 border-t border-zinc-200 pt-6 text-sm text-zinc-600 dark:border-zinc-800 dark:text-zinc-400">
        <p role="note" class="font-semibold text-zinc-900 dark:text-zinc-100">{s.notAdvice}</p>
        {s.aboutData && <p>{s.aboutData}</p>}
        {s.repo && <p>Found a wrong fact? <a class={link} href={s.repo}>Open an issue or a pull request</a>, with a source link.</p>}
        <p>Code: MIT. Data and text: CC BY 4.0. No cookies, no tracking, no ads.</p>
      </footer>
    </main>

    <script is:inline>
      // Filters, and a detail panel for each row. Without script, all panels stay open.
      const filters = document.querySelectorAll('[data-filter]');
      for (const b of filters) {
        b.addEventListener('click', () => {
          for (const x of filters) x.setAttribute('aria-pressed', String(x === b));
          for (const t of document.querySelectorAll('tbody[data-group]')) {
            t.hidden = b.dataset.filter !== 'all' && t.dataset.group !== b.dataset.filter;
          }
        });
      }
      for (const btn of document.querySelectorAll('button[aria-controls]')) {
        const panel = document.getElementById(btn.getAttribute('aria-controls'));
        const set = (open) => { btn.setAttribute('aria-expanded', String(open)); panel.hidden = !open; };
        set(false);
        btn.addEventListener('click', (ev) => { ev.stopPropagation(); set(panel.hidden); });
        btn.closest('tr').addEventListener('click', () => set(panel.hidden));
      }
    </script>
  </body>
</html>
